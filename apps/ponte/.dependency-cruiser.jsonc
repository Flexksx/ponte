{
  "$schema": "https://raw.githubusercontent.com/sverweij/dependency-cruiser/main/src/schema/configuration.schema.json",

  "forbidden": [
    {
      "name": "no-circular",
      "comment": "A cycle makes the layer order meaningless. Break it with a new module that both sides import.",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "no-orphans",
      "comment": "Nothing imports this file. Delete it, or import it. Ambient declaration files and tests are exempt.",
      "severity": "error",
      "from": { "orphan": true, "pathNot": ["\\.d\\.ts$", "^tests/"] },
      "to": {}
    },
    {
      "name": "not-to-unresolvable",
      "comment": "The import target does not exist. Fix the path or install the package.",
      "severity": "error",
      "from": {},
      "to": { "couldNotResolve": true }
    },
    {
      "name": "core-through-package",
      "comment": "App code and app tests import core as @ponte/core, never by a relative path into libs/core.",
      "severity": "error",
      "from": { "path": "^(src|tests)/" },
      "to": { "path": "(^|/)libs/core/", "dependencyTypes": ["local"] }
    },
    {
      "name": "core-through-barrel",
      "comment": "App code and app tests reach core only through its top-level barrel, which is the public API of the package.",
      "severity": "error",
      "from": { "path": "^(src|tests)/" },
      "to": {
        "path": "(^|/)libs/core/",
        "pathNot": "(^|/)libs/core/src/index\\.ts$"
      }
    },
    {
      "name": "no-dev-deps-in-src",
      "comment": "Development tools must not reach the shipped binary. Move the import to tests, or move the package to dependencies.",
      "severity": "error",
      "from": { "path": "^src/" },
      "to": {
        "dependencyTypes": ["npm-dev"],
        "pathNot": ["node_modules/.*@types"]
      }
    },
    {
      "name": "no-src-to-tests",
      "comment": "Production code must not import test code.",
      "severity": "error",
      "from": { "path": "^src/" },
      "to": { "path": "^tests/" }
    },
    {
      "name": "only-bootstrap-wires-infra",
      "comment": "Only the composition root, src/bootstrap.ts, imports an adapter. A use case gets its adapters injected, typed by a port in @ponte/core.",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "^src/(infra/|bootstrap\\.ts$)" },
      "to": { "path": "^src/infra/" }
    },
    {
      "name": "bootstrap-only-from-entry",
      "comment": "Only the entry point calls the composition root.",
      "severity": "error",
      "from": { "pathNot": "^src/index\\.ts$" },
      "to": { "path": "^src/bootstrap\\.ts$" }
    },
    {
      "name": "entry-point-starts-the-cli",
      "comment": "src/index.ts builds the app with the composition root and hands it to the CLI. It holds no other logic.",
      "severity": "error",
      "from": { "path": "^src/index\\.ts$" },
      "to": { "pathNot": "^src/(cli/|bootstrap\\.ts$)" }
    },
    {
      "name": "cli-uses-core-ports",
      "comment": "The CLI drives the app through the App port from @ponte/core. It never imports a use case.",
      "severity": "error",
      "from": { "path": "^src/cli/" },
      "to": { "path": "^src/app/" }
    },
    {
      "name": "app-does-not-print",
      "comment": "A use case must not import the CLI layer. Return data and let the CLI format it.",
      "severity": "error",
      "from": { "path": "^src/app/" },
      "to": { "path": "^src/cli/" }
    },
    {
      "name": "app-has-no-io",
      "comment": "A use case does I/O only through its injected ports. It imports no Node or Bun runtime module except path.",
      "severity": "error",
      "from": { "path": "^src/app/" },
      "to": {
        "dependencyTypes": ["core"],
        "pathNot": "^path$"
      }
    },
    {
      "name": "app-has-no-bun",
      "comment": "A use case does I/O only through its injected ports, so it never imports the Bun runtime.",
      "severity": "error",
      "from": { "path": "^src/app/" },
      "to": { "path": "(^|/)@types/bun/" }
    },
    {
      "name": "infra-is-a-leaf",
      "comment": "An adapter must not call back into a use case, the CLI or the composition root.",
      "severity": "error",
      "from": { "path": "^src/infra/" },
      "to": { "path": "^src/(app/|cli/|bootstrap\\.ts$)" }
    }
  ],

  "options": {
    "doNotFollow": { "path": "node_modules" },
    "tsPreCompilationDeps": true,
    "tsConfig": { "fileName": "tsconfig.json" },

    // chalk publishes an `exports` map, so the resolver needs to read it.
    "enhancedResolveOptions": {
      "exportsFields": ["exports"],
      "conditionNames": ["import", "node", "default"]
    }
  }
}
