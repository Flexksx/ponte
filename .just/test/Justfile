set working-directory := "../.."

[private]
default:
    just --list --justfile {{source_file()}}

# Run the unit + integration test suite
unit:
    bun test ./apps/ponte/tests

# Run the end-to-end suite (spawns the compiled CLI against isolated homes)
e2e:
    bun test ./apps/ponte/tests/e2e

# Run everything
all: unit e2e