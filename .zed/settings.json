{
  "load_direnv": "shell_hook",
  "language_servers": ["biome"],
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "code_actions": {
          "source.organizeImports": true,
        },
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "code_actions": {
          "source.organizeImports": true,
        },
      },
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/vendor",
  ],
}
