{
  "load_direnv": "shell_hook",
  "language_servers": ["biome", "vtsls"],
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true,
          },
          "referencesCodeLens": {
            "enabled": true,
            "showOnAllFunctions": true,
          },
        },
        "javascript": {
          "implementationsCodeLens": {
            "enabled": true,
            "showOnAllClassMethods": true,
            "showOnInterfaceMethods": true,
          },
          "referencesCodeLens": {
            "enabled": true,
            "showOnAllFunctions": true,
          },
        },
      },
    },
  },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "code_actions": {
          "source.organizeImports": true,
        },
      },
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "code_actions": {
          "source.organizeImports": true,
        },
      },
    },
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/vendor",
  ],
}
