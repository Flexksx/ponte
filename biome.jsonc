{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",

  "files": {
    "includes": ["apps/*/src/**", "apps/*/tests/**"],
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },

  "formatter": {
    "enabled": true,
    "lineWidth": 100,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "trailingNewline": true,
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all",
    },
    "linter": {
      "enabled": true,
    },
  },

  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
    },
    "linter": {
      "enabled": true,
    },
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" },
        },
      },
    },
  },
}
